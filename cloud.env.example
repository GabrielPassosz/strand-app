# Copy to .env.cloud for LOCAL administrative commands. Never commit real secrets.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=SEU-PROJETO.vercel.app
PUBLIC_ORIGIN=https://SEU-PROJETO.vercel.app
CSRF_TRUSTED_ORIGINS=https://SEU-PROJETO.vercel.app
# Supabase Connect > transaction pooler; use session pooler for migrations if necessary.
DATABASE_URL=
DATABASE_SSL_REQUIRED=True
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=strand-private
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Strand <noreply@SEU-DOMINIO.com>
CRON_SECRET=
