# Copy to production.env. Keep private; do not commit or share this file.
DOMAIN=app.your-domain.com
# Generate each secret with: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=
# Use a generated hexadecimal value, so the database URL needs no escaping.
DB_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Strand <noreply@your-domain.com>
